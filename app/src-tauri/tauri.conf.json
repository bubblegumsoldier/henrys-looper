{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Henrys Looper",
  "version": "0.1.0",
  "identifier": "de.getmika.henrys-looper",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../ui run dev",
    "beforeBuildCommand": "npm --prefix ../../ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Henrys Looper",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
